screen w h;

int cell = 20;
int gw = w / cell;
int gh = h / cell;

// body arrays
alloc bx 500;
alloc by 500;

int len = 3;
int hx = gw / 2;
int hy = gh / 2;
int dx = 1;
int dy = 0;

initbody();
newfood();

// runs until walls() or selfbite() jumps to dead
while (0 == 0) {
   input();
   move();
   draw();
   wait 110;
   flip;
}

sub initbody() {
   int i = 0;
   int t = 0;

   while (i < len) {
      t = hx - i;
      poke bx i t;
      poke by i hy;
      i = i + 1;
   }
}

sub input() {
   key right k;
   if (k != 0) {
      if (dx != -1) {
         dx = 1;
         dy = 0;
      }
   }

   key left k;
   if (k != 0) {
      if (dx != 1) {
         dx = -1;
         dy = 0;
      }
   }

   key up k;
   if (k != 0) {
      if (dy != 1) {
         dx = 0;
         dy = -1;
      }
   }

   key down k;
   if (k != 0) {
      if (dy != -1) {
         dx = 0;
         dy = 1;
      }
   }
}

sub move() {
   shiftbody();
   hx = hx + dx;
   hy = hy + dy;
   poke bx 0 hx;
   poke by 0 hy;
   walls();
   selfbite();
   food();
}

sub shiftbody() {
   int j = 0;
   i = len - 1;

   while (i > 0) {
      j = i - 1;
      peek bx j t;
      poke bx i t;
      peek by j t;
      poke by i t;
      i = i - 1;
   }
}

sub walls() {
   if (hx < 0) goto dead;
   if (hy < 0) goto dead;
   if (hx >= gw) goto dead;
   if (hy >= gh) goto dead;
}

sub selfbite() {
   i = 1;

   while (i < len) {
      peek bx i t;
      if (t == hx) {
         peek by i t;
         if (t == hy) goto dead;
      }
      i = i + 1;
   }
}

sub food() {
   if (hx == fx) {
      if (hy == fy) {
         int tail = len - 1;
         peek bx tail tx;
         peek by tail ty;
         poke bx len tx;
         poke by len ty;
         len = len + 1;

         if (len >= 500) {
            len = 499;
         }

         newfood();
      }
   }
}

sub newfood() {
   rnd fx gw;
   rnd fy gh;
}

sub draw() {
   int px = fx * cell;
   int py = fy * cell;
   rect px py cell cell 0xFF0000;

   int u = 0;
   i = 0;

   while (i < len) {
      peek bx i t;
      t = t * cell;
      peek by i u;
      u = u * cell;
      rect t u cell cell 0x00FF00;
      i = i + 1;
   }

   int sc = len - 3;
   num 10 10 sc;
}

label dead;
text 100 100 "GAME OVER";
num 100 140 sc;
flip;
wait 2000;
end;
