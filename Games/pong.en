screen w h;

// speed
int pspeed = 6;
int bspeed = 5;

int p1y = 200;
int p2y = 200;

int pad2x = w - 40;
int p2hit = pad2x - 15;

int maxy = h - 90;
int bmax = h - 15;
int s2x = w - 140;

int s1 = 0;
int s2 = 0;

int bx = 0;
int by = 0;
int dx = 0;
int dy = 0;
serve();

while (0 == 0) {
   input();
   clamp();
   move();
   draw();
   wait 16;
   flip;
}

sub input() {
   key w k;
   if (k != 0) {
      p1y = p1y - pspeed;
   }

   key s k;
   if (k != 0) {
      p1y = p1y + pspeed;
   }

   key up k;
   if (k != 0) {
      p2y = p2y - pspeed;
   }

   key down k;
   if (k != 0) {
      p2y = p2y + pspeed;
   }
}

sub clamp() {
   if (p1y < 0) {
      p1y = 0;
   } else if (p1y > maxy) {
      p1y = maxy;
   }

   if (p2y < 0) {
      p2y = 0;
   } else if (p2y > maxy) {
      p2y = maxy;
   }
}

sub move() {
   bx = bx + dx;
   by = by + dy;

   if (by <= 0) {
      dy = -dy;
      by = by + dy;
   } else if (by >= bmax) {
      dy = -dy;
      by = by + dy;
   }

   // left paddle
   if (bx <= 40) {
      if (by >= p1y) {
         if (by <= p1y + 90) {
            dx = -dx;
            bx = 41;
         }
      }
   }

   // right paddle
   if (bx >= p2hit) {
      if (by >= p2y) {
         if (by <= p2y + 90) {
            dx = -dx;
            bx = p2hit - 1;
         }
      }
   }

   if (bx <= 0) {
      s2 = s2 + 1;
      serve();
   } else if (bx >= w) {
      s1 = s1 + 1;
      serve();
   }
}

sub serve() {
   bx = w / 2;
   by = h / 2;
   dx = bspeed;
   dy = bspeed;
}

sub draw() {
   rect 20 p1y 15 90 0xFFFFFF;
   rect pad2x p2y 15 90 0xFFFFFF;
   rect bx by 15 15 0x00FF00;
   num 100 10 s1;
   num s2x 10 s2;
}
